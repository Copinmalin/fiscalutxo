{
  "name": "fiscalutxo",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first Bitcoin-only tax preparation helper for French residents.",
  "type": "module",
  "bin": {
    "fiscalutxo": "./dist/src/cli/fiscalutxo.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/web/public', 'dist/src/web/public', { recursive: true })\"",
    "cli": "node ./dist/src/cli/fiscalutxo.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir tests",
    "start": "node dist/src/web/main.js"
  },
  "keywords": [
    "bitcoin",
    "tax",
    "csv",
    "local-first",
    "france"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
